       bin.bin_code,
       lot.lot_code,
       lot.PROD_CODE,
       lot.prod_name,
			 pd.pdd_desc,
			 to_char(lot.ACTUAL_COMPLETE_DATE, 'YYYY-MM-DD HH24:MI') as endDate,
       packprod.prod_code,
       packprod.prod_name,
       mo.cust_code,
       mo.cust_name,
       mo.order_type,
       mo.mo_order_group,
       CASE
       
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          (CASE
          
            WHEN instr(packprod.prod_name, '[') > 0 THEN
             substr(packprod.prod_name,
                    0,
                    (instr(packprod.prod_name, '[', 1) - 1))
            ELSE
             packprod.prod_name
          END)
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.prod_name
         ELSE
          ''
       END AS custType,
       CASE
       
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          packprod.prod_name
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.pid_code
