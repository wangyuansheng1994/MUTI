	t2.CUST_LOT_CODE,
	t1.LOT_TYPE,
	t1.TRACKING_CODE,
	t1.SHIP_TO_ADDRESS,
	t1.SHIP_TO_CODE,
	t1.SHIP_TO_PHONE,
	t1.SHIP_TO_NAME,
	t1.REMARK,
