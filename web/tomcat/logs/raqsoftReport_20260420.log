	a.packinglist_code,
	a.packinglist_date,
	a.prod_good_qty,
	a.prod_defect_qty,
	a.TRACKING_CODE,
	a.receive_address_desc,
	a.PROD_QTY,
	a.RECEIVE_CORP_NAME,
	a.RECEIVE_PSN_TEL,
	a.RECEIVE_PSN_NAME,
	a.TRACKING_DESC,
	prod.lot_code 
