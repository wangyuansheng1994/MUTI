         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.pid_code
         ELSE
          ''
       END AS model,
       lot.prod_name,
       a.goods_qty,
       lot.lot_status as lotStatus,
       so.cust_lot,
       so.cust_po_code,
