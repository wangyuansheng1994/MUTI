	TO_CHAR( m.MO_DATE, 'IW' ))) AS dc,
	b.createDate,
	'BIN1' as bin
FROM
	lot_info t
	JOIN (
SELECT DISTINCT
	a.packinglist_code,
	sum( t.PROD_QTY_ACTUAL ) AS goodQty,
	a.packinglist_date,
	a.prod_good_qty,
	a.prod_defect_qty,
	a.TRACKING_CODE,
