    ON mo.row_id = lot.mo_id
  LEFT JOIN wo_work_order wo
    ON mo.wo_id = wo.row_id
  LEFT JOIN so_sale_order so
    ON wo.so_id = so.row_id
left join md_product_layer layerProd
    on layerProd.Prod_Id = lot.prod_id
left join md_product_layer_attr attr
    on attr.prod_layer_id = layerProd.row_id
 WHERE b.position_type = 'Middle'
