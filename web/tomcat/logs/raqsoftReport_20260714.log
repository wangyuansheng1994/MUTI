	t2.CUST_ORDER_CODE,
	t2.PROD_NAME,
	t1.SERIES_NAME,
	t1.SAP_SO_CODE,
	t2.CUST_LOT_CODE,
	t1.LOT_TYPE,
	t1.TRACKING_CODE,
	t1.SHIP_TO_ADDRESS,
