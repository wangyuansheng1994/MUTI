    ON pack.row_id = b.goods_id
  LEFT JOIN lot_pack_prod packprod
    ON packprod.pack_id = pack.row_id
  LEFT JOIN lot_info lot
    ON lot.row_id = packprod.lot_id
  LEFT JOIN md_product prod
    ON prod.row_id = lot.prod_id
  LEFT JOIN md_prod_bin bin
    ON bin.row_id = lot.bin_id
