UNION
SELECT '内盒库出库' AS "wms_type",
       b.row_id,
       b.GOODS_CODE AS goodsCode,
       mo.mo_order_group,
       pack.lot_code,
       b.goods_qty,
       prod.cust_code,
       prod.cust_name,
       pack.barcode_val,
       CASE
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          prod.cust_prod_name
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.prod_name
         ELSE
          ''
       END AS custType,
       so.pid_code,
       lot.prod_name,
       so.cust_lot,
       bin.bin_code,
       so.cust_po_code,
       so.CUST_PROD_VER_CODE,
       case
         when mo.order_type = 'E' THEN
          '工程'
         when mo.order_type = 'LVM' THEN
          '小批量'
         when mo.order_type = 'HVM' THEN
          '大批量'
         else
