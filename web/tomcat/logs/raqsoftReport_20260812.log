       end order_type,
       substr(dc.calendar_week, 3) dc,
       lot.mrb_code,
       to_char(b.UPD_DATE, 'YYYY-MM-DD') AS createDate,
       to_char(b.UPD_DATE, 'HH24:MI') AS createTime,
       packprod.lot_code,
       receive.receive_psn_name,
       receive.receive_address_desc
  FROM wms_inventory b
  LEFT JOIN lot_pack pack
    ON pack.row_id = b.goods_id
  left join (select a.row_id, d.receive_psn_name, d.receive_address_desc
