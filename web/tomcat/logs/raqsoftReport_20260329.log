       decode(a.hold_flag,'Y','Hold','N','Release','','') as holdFlag ,
       md.unit_code,
       so.CUST_PROD_VER_CODE,
       bin.bin_code,
       pack.lot_code,
       packprod.prod_code,
       packprod.prod_name,
       mo.cust_code,
