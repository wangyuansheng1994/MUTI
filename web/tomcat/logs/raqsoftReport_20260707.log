   AND a.del_flag = '0'
   AND pack.del_flag = '0'
   AND pack.pack_status = 'Y'
   AND prod.row_id = lot.prod_id
   AND prod.del_flag = '0'
   AND lot.row_id = pack.lot_id
   AND lot.del_flag = '0'
   AND mo.del_flag = '0'
