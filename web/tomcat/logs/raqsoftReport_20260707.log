             packprod.prod_name
          END)
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.prod_name
         ELSE
          ''
       END AS custType,
       CASE
       
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          packprod.prod_name
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.pid_code
