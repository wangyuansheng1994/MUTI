INFO: ds1=SELECT
	* 
FROM
	(
SELECT
	to_char( b.packinglist_date, 'YYYY-MM-DD' ) AS PACKINGLIST_DATE,--出货日期
	b.packinglist_code,--送货指令单据编号
	s.cust_code,--Cust. Code
	s.cust_code_s,--Lansus Code
	s.WAFER_REMARK as deviceCode,
	s.cust_order_code,--WO 上的PO No(D列）-- 	p.cust_prod_code,
	REPLACE ( p.CUST_PROD_NAME, 'TR1', '' ) AS cust_prod_code,--Device Code
	p.series_name,-- Device
	p.pdd_tgt_name,--OSAT Device
	s.sap_so_code,--OSAT.Lot no
	s.cust_lot,--Lot No
	p.produce_phase_type,--Lot Type
		CASE 
	WHEN p.process_segment_type ='ASSY' THEN
		'A'
	WHEN p.process_segment_type ='FT' THEN
		'T'
	WHEN p.process_segment_type ='ASSY_FT' THEN
		'A+T'
END AS process_segment_type,
	b.TRACKING_CODE,
	b.receive_address_desc,--Ship to Address
	b.PROD_QTY,
	b.RECEIVE_CORP_NAME,
	b.RECEIVE_PSN_TEL,
	b.RECEIVE_PSN_NAME,
	b.TRACKING_DESC,
	b.goodQty,
	to_char(
	to_char(
	TO_CHAR( TRUNC( m.MO_DATE ), 'YY' )) || to_char(
	TO_CHAR( m.MO_DATE, 'IW' ))) AS dc,
	b.createDate,
	'BIN1' as bin
FROM
	lot_info t
	JOIN (
SELECT DISTINCT
	a.packinglist_code,
	sum( t.PROD_QTY_ACTUAL ) AS goodQty,
	a.packinglist_date,
	a.prod_good_qty,
	a.prod_defect_qty,
	a.TRACKING_CODE,
	a.receive_address_desc,
	a.PROD_QTY,
	a.RECEIVE_CORP_NAME,
	a.RECEIVE_PSN_TEL,
	a.RECEIVE_PSN_NAME,
	a.TRACKING_DESC,
	prod.lot_code,
	max(a.CREATE_DATE) as createDate
FROM
	LOT_PACK_PACKINGLIST a
	JOIN lot_pack_packinglist_dtl d ON a.row_id = d.packinglist_id 
	AND d.del_flag = '0'
	LEFT JOIN LOT_PACK t ON d.lot_pack_id = t.row_id 
	AND t.del_flag = '0' 
	AND t.PACK_STATUS = 'Y'
	LEFT JOIN lot_pack_prod prod ON t.row_id = prod.pack_id 
	AND prod.del_flag = '0' 
WHERE
	a.del_flag = '0' AND A.packinglist_date>=TO_DATE('2023-11-01','YYYY-MM-DD')
GROUP BY
	a.packinglist_code,
	a.packinglist_date,
	a.prod_good_qty,
	a.prod_defect_qty,
	a.TRACKING_CODE,
	a.receive_address_desc,
	a.PROD_QTY,
	a.RECEIVE_CORP_NAME,
	a.RECEIVE_PSN_TEL,
	a.RECEIVE_PSN_NAME,
	a.TRACKING_DESC,
	prod.lot_code 
	) b ON t.lot_code = b.lot_code
	JOIN pd_design p ON t.pd_design_id = p.row_id
	LEFT JOIN mo_order m ON t.mo_id = m.row_id
	LEFT JOIN wo_work_order w ON m.wo_id = w.row_id
	LEFT JOIN so_sale_order s ON w.so_id = s.row_id 
WHERE
	t.del_flag = '0' 
	AND p.del_flag = '0' 
	AND m.del_flag = '0' 
	AND s.del_flag = '0' UNION ALL
SELECT
	to_char( t1.OUTBOUND_DATE, 'YYYY-MM-DD' ) AS PACKINGLIST_DATE,
	NULL AS packinglist_code,
	t2.cust_code AS cust_code,
	t2.CUST_CODE_S AS cust_code_s,
	t2.INNER_CODE as deviceCode,
	t2.CUST_ORDER_CODE AS cust_order_code,
	REPLACE ( t2.PROD_NAME, 'TR1', '' ) as cust_prod_code,
	t1.SERIES_NAME AS series_name,
	NULL AS pdd_tgt_name,
	t1.SAP_SO_CODE AS sap_so_code,
	t2.CUST_LOT_CODE AS cust_lot,
	t1.LOT_TYPE AS produce_phase_type,
-- 	CASE 
-- 	WHEN t2.ORDER_TYPE ='A' THEN
-- 		'ASSY'
-- 	WHEN t2.ORDER_TYPE ='T' THEN
-- 		'FT'
-- 	WHEN t2.ORDER_TYPE ='A+T' THEN
-- 		'ASSY_FT'
-- END AS process_segment_type,
t2.ORDER_TYPE as process_segment_type,
	t1.TRACKING_CODE AS TRACKING_CODE,
	t1.SHIP_TO_ADDRESS AS receive_address_desc,
	0 AS PROD_QTY,
	t1.SHIP_TO_CODE AS RECEIVE_CORP_NAME,
	t1.SHIP_TO_PHONE AS RECEIVE_PSN_TEL,
	t1.SHIP_TO_NAME AS RECEIVE_PSN_NAME,
	t1.REMARK AS TRACKING_DESC,
	SUM(TO_NUMBER( t2.LOT_QTY )) AS goodQty,
	t2.DC_CODE AS dc,
	max(t1.CREATE_DATE) as createDate,
	'BIN' || t2.bin_code as bin
FROM
	OUTBOUND_WITHOUT_ORDER t1
	LEFT JOIN RECEIPT_WITHOUT_ORDER t2 ON t1.RECEIPT_ID = t2.row_id 
	AND t2.del_flag = '0' 
  WHERE t1.OUTBOUND_DATE>=TO_DATE('2023-11-01','YYYY-MM-DD')
	AND t1.del_flag = '0'
	GROUP BY
	to_char( t1.OUTBOUND_DATE, 'YYYY-MM-DD' ),
	t2.cust_code,
	t2.CUST_CODE_S,
	t2.CUST_ORDER_CODE,
	t2.PROD_NAME,
	t1.SERIES_NAME,
	t1.SAP_SO_CODE,
	t2.CUST_LOT_CODE,
	t1.LOT_TYPE,
	t1.TRACKING_CODE,
	t1.SHIP_TO_ADDRESS,
	t1.SHIP_TO_CODE,
	t1.SHIP_TO_PHONE,
	t1.SHIP_TO_NAME,
	t1.REMARK,
	t2.DC_CODE,
	t2.ORDER_TYPE,
	t2.INNER_CODE,
	t2.bin_code
	) last 

ORDER BY last.createDate desc

