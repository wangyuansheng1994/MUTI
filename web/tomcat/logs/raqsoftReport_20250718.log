INFO: ds4=select a.mo_order_group,
   listagg(a.marking, ';') within group(order by a.mo_order_group) AS marking
from (SELECT distinct  mo.mo_order_group,
       listagg(a.marking_val, '/') within group(order by a.marking_line_order) AS marking
  FROM lot_info_marking_line a
  left join lot_info_marking mark
    on mark.row_id = a.lot_info_marking_id
   and mark.del_flag = '0'
  left join lot_info info
    on info.row_id = mark.lot_id
   and info.del_flag = '0'
  left join mo_order mo
    on mo.row_id = info.mo_id
 where a.del_flag = '0'
and mo.mo_order_group is not null
 group by mo.mo_order_group, a.lot_info_marking_id) a
  group by a.mo_order_group

