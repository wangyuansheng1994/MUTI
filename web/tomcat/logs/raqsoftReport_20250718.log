	t1.LOT_TYPE,
	t1.TRACKING_CODE,
	t1.SHIP_TO_ADDRESS,
	t1.SHIP_TO_CODE,
	t1.SHIP_TO_PHONE,
	t1.SHIP_TO_NAME,
	t1.REMARK,
	t2.DC_CODE,
	t2.ORDER_TYPE,
	t2.INNER_CODE,
	t2.bin_code
	) last 

