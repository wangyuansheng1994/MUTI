SELECT DISTINCT
	t1.W_LOT_ID,t1.lot_code,t1.BARCODE_VAL
FROM
	LOT_PACK t1 
WHERE
	t1.pack_status = 'Y' 
	AND t1.W_LOT_ID IS NOT NULL 
	) t3
	on t2.lot_id =t3.W_LOT_ID
	 where t2.del_flag = '0'
   and t2.container_type = 'BOX_O'
   and t2.lot_code like 'W%'
   and t2.pack_status = 'Y'
   and to_char(t2.create_date, 'YYYY-MM-DD') >= ?
   and to_char(t2.create_date, 'YYYY-MM-DD') <= ?

