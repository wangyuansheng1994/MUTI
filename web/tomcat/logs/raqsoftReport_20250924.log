	a.receive_address_desc,
	a.PROD_QTY,
	a.RECEIVE_CORP_NAME,
	a.RECEIVE_PSN_TEL,
	a.RECEIVE_PSN_NAME,
	a.TRACKING_DESC,
	prod.lot_code 
	) b ON t.lot_code = b.lot_code
	JOIN pd_design p ON t.pd_design_id = p.row_id
