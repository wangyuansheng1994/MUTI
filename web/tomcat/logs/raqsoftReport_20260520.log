	'BIN' || t2.bin_code as bin
FROM
	OUTBOUND_WITHOUT_ORDER t1
	LEFT JOIN RECEIPT_WITHOUT_ORDER t2 ON t1.RECEIPT_ID = t2.row_id 
	AND t2.del_flag = '0' 
  WHERE t1.OUTBOUND_DATE>=TO_DATE('2023-11-01','YYYY-MM-DD')
	AND t1.del_flag = '0'
	GROUP BY
	to_char( t1.OUTBOUND_DATE, 'YYYY-MM-DD' ),
	t2.cust_code,
	t2.CUST_CODE_S,
	t2.CUST_ORDER_CODE,
	t2.PROD_NAME,
	t1.SERIES_NAME,
	t1.SAP_SO_CODE,
	t2.CUST_LOT_CODE,
	t1.LOT_TYPE,
	t1.TRACKING_CODE,
	t1.SHIP_TO_ADDRESS,
	t1.SHIP_TO_CODE,
	t1.SHIP_TO_PHONE,
	t1.SHIP_TO_NAME,
	t1.REMARK,
	t2.DC_CODE,
	t2.ORDER_TYPE,
	t2.INNER_CODE,
	t2.bin_code
	) last 

ORDER BY last.createDate desc

