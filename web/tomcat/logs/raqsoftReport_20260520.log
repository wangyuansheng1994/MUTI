INFO: ds1=SELECT '内盒库入库' AS "wms_type",
       b.row_id,
       b.GOODS_CODE AS goodsCode,
       mo.mo_order_group,
       pack.lot_code,
       b.goods_qty,
       prod.cust_code,
       prod.cust_name,
       pack.barcode_val,
       CASE
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          prod.cust_prod_name
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.prod_name
         ELSE
          ''
       END AS custType,
       so.pid_code,
       lot.prod_name,
       so.cust_lot,
       bin.bin_code,
       so.cust_po_code,
       so.CUST_PROD_VER_CODE,
       case
         when mo.order_type = 'E' THEN
          '工程'
         when mo.order_type = 'LVM' THEN
          '小批量'
         when mo.order_type = 'HVM' THEN
          '大批量'
         else
          ''
       end order_type,
       substr(dc.calendar_week, 3) dc,
       lot.mrb_code,
       to_char(b.create_date, 'YYYY-MM-DD') AS createDate,
       to_char(b.create_date, 'HH24:MI') AS createTime,
       packprod.lot_code,
       null as receive_psn_name,
       null as receive_address_desc
  FROM wms_inventory b
  LEFT JOIN lot_pack pack
    ON pack.row_id = b.goods_id
  LEFT JOIN lot_pack_prod packprod
    ON packprod.pack_id = pack.row_id
  LEFT JOIN lot_info lot
    ON lot.row_id = packprod.lot_id
  LEFT JOIN md_product prod
    ON prod.row_id = lot.prod_id
  LEFT JOIN md_prod_bin bin
    ON bin.row_id = lot.bin_id
  LEFT JOIN mo_order mo
    ON mo.row_id = lot.mo_id
  LEFT JOIN wo_work_order wo
    ON mo.wo_id = wo.row_id
  LEFT JOIN so_sale_order so
    ON wo.so_id = so.row_id
  left join md_factory_calendar_dc dc
    ON TO_CHAR(mo.prod_date, 'YYYY-MM-DD') =
       TO_CHAR(to_date(DC.Calendar_Date, 'YYYY-MM-DD'), 'YYYY-MM-DD'),wms_inventory_his his
 WHERE b.position_type = 'Middle'
   AND b.position_code = 'PK_BOX'
   AND pack.del_flag = '0'
   AND packprod.del_flag = '0'
   AND prod.del_flag = '0'
   AND lot.del_flag = '0'
   and b.Del_Flag = '0'
   and b.row_id = his.inv_id
   and his.event_type = 'BoxInv'
   and (mo.mo_order_group like ? or ? is null)
   and (pack.lot_code like ? or ? is null)
   and (prod.cust_code like ? or ? is null)
   and (b.goods_code like ? or ? is null)
   and to_char(b.UPD_DATE, 'YYYY-MM-DD') >= ?
   and to_char(b.UPD_DATE, 'YYYY-MM-DD') <= ?
UNION
SELECT '内盒库出库' AS "wms_type",
       b.row_id,
       b.GOODS_CODE AS goodsCode,
       mo.mo_order_group,
       pack.lot_code,
       b.goods_qty,
       prod.cust_code,
       prod.cust_name,
       pack.barcode_val,
       CASE
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          prod.cust_prod_name
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.prod_name
         ELSE
          ''
       END AS custType,
       so.pid_code,
       lot.prod_name,
       so.cust_lot,
       bin.bin_code,
       so.cust_po_code,
       so.CUST_PROD_VER_CODE,
       case
         when mo.order_type = 'E' THEN
          '工程'
         when mo.order_type = 'LVM' THEN
          '小批量'
         when mo.order_type = 'HVM' THEN
          '大批量'
         else
          ''
       end order_type,
       substr(dc.calendar_week, 3) dc,
       lot.mrb_code,
       to_char(b.UPD_DATE, 'YYYY-MM-DD') AS createDate,
       to_char(b.UPD_DATE, 'HH24:MI') AS createTime,
       packprod.lot_code,
       receive.receive_psn_name,
       receive.receive_address_desc
  FROM wms_inventory b
  LEFT JOIN lot_pack pack
    ON pack.row_id = b.goods_id
  left join (select a.row_id, d.receive_psn_name, d.receive_address_desc
               from lot_pack a
               left join lot_info b
                 on a.lot_id = b.row_id
               left join lot_pack_packinglist c
                 on b.packinglist_id = c.packinglist_code
               left join lot_pack_packinglist_group d
                 on c.packinglist_group_id = d.row_id
              where a.del_flag = '0'
                and b.del_flag = '0'
                and c.del_flag = '0'
                and d.del_flag = '0') receive
    on receive.row_id = pack.row_id
  LEFT JOIN lot_pack_prod packprod
    ON packprod.pack_id = pack.row_id
  LEFT JOIN lot_info lot
    ON lot.row_id = packprod.lot_id
  LEFT JOIN md_product prod
    ON prod.row_id = lot.prod_id
  LEFT JOIN md_prod_bin bin
    ON bin.row_id = lot.bin_id
  LEFT JOIN mo_order mo
    ON mo.row_id = lot.mo_id
  LEFT JOIN wo_work_order wo
    ON mo.wo_id = wo.row_id
  LEFT JOIN so_sale_order so
    ON wo.so_id = so.row_id
  left join md_factory_calendar_dc dc
    ON TO_CHAR(mo.prod_date, 'YYYY-MM-DD') =
       TO_CHAR(to_date(DC.Calendar_Date, 'YYYY-MM-DD'), 'YYYY-MM-DD'),wms_inventory_his his
 WHERE b.DEL_FLAG = '0'
   AND b.position_type = 'Middle'
   AND b.position_code = 'PK_BOX'
   AND pack.del_flag = '0'
   AND packprod.del_flag = '0'
   AND prod.del_flag = '0'
   AND lot.del_flag = '0'
   and b.row_id = his.inv_id
   and his.event_type = 'P_INV'
   and (mo.mo_order_group like ? or ? is null)
   and (pack.lot_code like ? or ? is null)
   and (prod.cust_code like ? or ? is null)
   and (b.goods_code like ? or ? is null)
   and to_char(b.UPD_DATE, 'YYYY-MM-DD') >= ?
   and to_char(b.UPD_DATE, 'YYYY-MM-DD') <= ?
 order by goodsCode desc

