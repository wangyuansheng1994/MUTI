		'A+T'
END AS process_segment_type,
	b.TRACKING_CODE,
	b.receive_address_desc,--Ship to Address
	b.PROD_QTY,
	b.RECEIVE_CORP_NAME,
	b.RECEIVE_PSN_TEL,
	b.RECEIVE_PSN_NAME,
