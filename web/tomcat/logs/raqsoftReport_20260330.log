INFO: ds5=SELECT DISTINCT
	t2.BARCODE_VAL as firstVAL,t3.BARCODE_VAL as val
FROM
	lot_pack t2
	LEFT JOIN (
SELECT DISTINCT
	t1.W_LOT_ID,t1.lot_code,t1.BARCODE_VAL
FROM
	LOT_PACK t1 
WHERE
	t1.pack_status = 'Y' 
	AND t1.W_LOT_ID IS NOT NULL 
	) t3
	on t2.lot_id =t3.W_LOT_ID
