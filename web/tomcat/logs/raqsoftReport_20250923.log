INFO: ds3=SELECT distinct mo.mo_order_group,
'内盒库入库' AS "wms_type",
      attr.attr_val as custApp
  FROM wms_inventory b
  LEFT JOIN lot_pack pack
    ON pack.row_id = b.goods_id
  LEFT JOIN lot_pack_prod packprod
    ON packprod.pack_id = pack.row_id
  LEFT JOIN lot_info lot
    ON lot.row_id = packprod.lot_id
  LEFT JOIN md_product prod
    ON prod.row_id = lot.prod_id
  LEFT JOIN md_prod_bin bin
    ON bin.row_id = lot.bin_id
  LEFT JOIN mo_order mo
    ON mo.row_id = lot.mo_id
  LEFT JOIN wo_work_order wo
    ON mo.wo_id = wo.row_id
  LEFT JOIN so_sale_order so
    ON wo.so_id = so.row_id
left join md_product_layer layerProd
    on layerProd.Prod_Id = lot.prod_id
left join md_product_layer_attr attr
    on attr.prod_layer_id = layerProd.row_id
 WHERE b.position_type = 'Middle'
   AND b.position_code = 'PK_BOX'
   AND pack.del_flag = '0'
  AND packprod.del_flag = '0'
   AND prod.del_flag = '0'
   AND lot.del_flag = '0'
   and attr.attr_code = 'P3264'

