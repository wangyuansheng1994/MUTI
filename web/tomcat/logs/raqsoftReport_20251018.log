a.goods_model,
a.goods_ver_num,
a.batch_no,
a.sp_id,
b.event_type,
b.event_code,
b.event_date,
b.event_user_name,
b.hold_reason_name,
b.hold_reason_code,
b.RELEASE_USER_NAME from
wms_inventory a
left join
wms_inventory_his b
on a.row_id = b.inv_id
and b.del_flag = '0',
