and a.position_type = 'Middle'
and a.position_code = 'PK_BOX'
and a.org_id = c.row_id 
and (a.batch_no like '%'||?||'%' or ? is null)
and (a.goods_code like '%'||?||'%' or ? is null)
and b.event_date > to_date(?,'yyyy-mm-dd hh24:mi:ss')
and b.event_date <  to_date(?,'yyyy-mm-dd hh24:mi:ss')
ORDER BY event_date desc

