       decode(a.hold_flag,'Y','Hold','N','Release','','') as holdFlag ,
       md.unit_code,
       so.CUST_PROD_VER_CODE,
       bin.bin_code,
       lot.lot_code,
       lot.PROD_CODE,
       lot.prod_name,
			 pd.pdd_desc,
