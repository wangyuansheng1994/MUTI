   listagg(po.cust_date_code, ',') within group(order by a.GOODS_CODE asc) custDC 
  FROM WMS_INVENTORY a
  LEFT JOIN lot_pack pack
    ON pack.row_id = a.goods_id
  left join lot_pack_prod prod
    on prod.pack_id = pack.row_id
  LEFT JOIN lot_info lot
    ON lot.row_id = prod.lot_id
  LEFT JOIN mo_order mo
    ON mo.row_id = lot.mo_id
  LEFT JOIN wo_work_order wo
    ON mo.wo_id = wo.row_id
  LEFT JOIN so_sale_order so
    ON wo.so_id = so.row_id
  LEFT JOIN po_cust_order po
    ON po.cust_po_code = so.cust_po_code
