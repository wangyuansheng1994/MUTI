   AND a.biz_status in ('WaitPutaway', 'Putaway','P_INV', 'Pairing','WPaireMerge') 
   AND pack.del_flag = '0'
   AND pack.pack_status = 'Y'
   AND prod.row_id = lot.prod_id
   AND prod.del_flag = '0'
   AND lot.del_flag = '0'
   AND mo.row_id = lot.mo_id
   AND mo.del_flag = '0'
   and a.biz_status in ('WaitPutaway')  
   AND TO_CHAR(mo.prod_date, 'YYYY-MM-DD') =
       TO_CHAR(to_date(DC.Calendar_Date, 'YYYY-MM-DD'), 'YYYY-MM-DD')
   and (step.step_code = ? or ? is null)
   and (lot.step_status = ? or ? is null)
   and (pack.lot_code like ? or ? is null)
   and (mo.mo_order_group like ? or ? is null)
   and (packprod.prod_name like ? or ? is null)
   and (md.UNIT_CODE like ? or ? is null)
   and (mo.cust_lot like ? or ? is null)
   and (a.goods_code like ? or ? is null)
   and to_char(a.create_date, 'YYYY-MM-DD') >= ?
   and to_char(a.create_date, 'YYYY-MM-DD') <= ?
   and (a.hold_flag like ? or ? is null)
   and(mo.cust_code like ? or ? is null)

UNION
SELECT a.goods_code,
       decode(a.biz_status,'Putaway','已接收','WaitPutaway','待上架','P_INV','已入成品库','Pairing','已配单','WPaireMerge','已包外箱') as bizStatus,
       decode(a.hold_flag,'Y','Hold','N','Release','','') as holdFlag ,
       md.unit_code,
       so.CUST_PROD_VER_CODE,
       bin.bin_code,
       lot.lot_code,
       lot.PROD_CODE,
       lot.prod_name,
			 pd.pdd_desc,
			 to_char(lot.ACTUAL_COMPLETE_DATE, 'YYYY-MM-DD HH24:MI') as endDate,
       packprod.prod_code,
       packprod.prod_name,
       mo.cust_code,
       mo.cust_name,
       mo.order_type,
       mo.mo_order_group,
       CASE
       
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          (CASE
          
            WHEN instr(packprod.prod_name, '[') > 0 THEN
             substr(packprod.prod_name,
                    0,
                    (instr(packprod.prod_name, '[', 1) - 1))
            ELSE
             packprod.prod_name
          END)
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.prod_name
         ELSE
          ''
       END AS custType,
       CASE
       
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          packprod.prod_name
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.pid_code
         ELSE
          ''
       END AS model,
       lot.prod_name,
       a.goods_qty,
       lot.lot_status as lotStatus,
       so.cust_lot,
       so.cust_po_code,
       lot.mrb_code,
       SUBSTR(DC.calendar_week, 3) AS dc,
	to_char( his.EVENT_DATE, 'YYYY-MM-DD HH24:MI' ) AS tradeDate 
  FROM wms_inventory a
	LEFT JOIN WMS_INVENTORY_HIS his ON his.inv_id = a.row_id 
	AND his.event_type = 'Putaway' 
	AND his.del_flag = '0'
  LEFT JOIN v_codelist vc
    ON vc.ENUM_CODE = a.biz_status
   and list_code = 'WMS_INVENTORY_BIZ_STATUS'
  LEFT JOIN md_whs_unit md
    ON a.whs_unit_id = md.row_id
  LEFT JOIN lot_pack pack
    ON pack.row_id = a.goods_id
  LEFT JOIN lot_pack_prod packprod
    ON packprod.pack_id = pack.row_id
  LEFT JOIN lot_info lot
