			 COUNT(l.wafer_id) AS wafer,
			 listagg(to_char(l.wafer_id),';') within group (order by l.wafer_id)  as wafer_id

  FROM lot_info      t,
       mo_order      m,
       pd_design     p,
       so_sale_order s,
       wo_work_order w,
			 (select t.lot_code,substr (l.wafer_id,instr(l.wafer_id,'-')+1) as wafer_id,l.row_id from lot_info      t,
       mo_order      m,wo_work_order w left join  WO_WORK_ORDER_MTL l on w.row_id = l.wo_id where  t.mo_id = m.row_id
   and m.wo_id = w.row_id) l 
 where t.mo_id = m.row_id
   and m.wo_id = w.row_id
   and w.so_id = s.row_id
	 and  t.lot_code = l.lot_code
   and t.pd_design_id = p.row_id
   and t.del_flag = '0'
   and m.del_flag = '0'
   and p.del_flag = '0'
   and s.del_flag = '0'
   and t.lot_code = ?
	 group by m.cust_code,
       t.cust_lot,
       p.cust_prod_code,
       s.cust_lot,
       t.lot_qty,
       t.lot_code,
       s.sap_so_code

