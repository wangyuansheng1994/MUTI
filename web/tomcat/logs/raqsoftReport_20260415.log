   AND prod.del_flag ='0'
   AND pack.del_flag = '0'
   AND lot.del_flag = '0'
   AND mo.del_flag = '0'
   AND wo.del_flag = '0'
   AND so.del_flag = '0'
   AND po.del_flag = '0'
