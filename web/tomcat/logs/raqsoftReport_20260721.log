	TO_CHAR( m.MO_DATE, 'IW' ))) AS dc,
	b.createDate,
	'BIN1' as bin
FROM
	lot_info t
	JOIN (
SELECT DISTINCT
	a.packinglist_code,
	sum( t.PROD_QTY_ACTUAL ) AS goodQty,
	a.packinglist_date,
	a.prod_good_qty,
	a.prod_defect_qty,
	a.TRACKING_CODE,
	a.receive_address_desc,
	a.PROD_QTY,
	a.RECEIVE_CORP_NAME,
	a.RECEIVE_PSN_TEL,
	a.RECEIVE_PSN_NAME,
	a.TRACKING_DESC,
	prod.lot_code,
	max(a.CREATE_DATE) as createDate
FROM
	LOT_PACK_PACKINGLIST a
	JOIN lot_pack_packinglist_dtl d ON a.row_id = d.packinglist_id 
	AND d.del_flag = '0'
	LEFT JOIN LOT_PACK t ON d.lot_pack_id = t.row_id 
	AND t.del_flag = '0' 
	AND t.PACK_STATUS = 'Y'
	LEFT JOIN lot_pack_prod prod ON t.row_id = prod.pack_id 
	AND prod.del_flag = '0' 
WHERE
	a.del_flag = '0' AND A.packinglist_date>=TO_DATE('2023-11-01','YYYY-MM-DD')
GROUP BY
	a.packinglist_code,
	a.packinglist_date,
	a.prod_good_qty,
