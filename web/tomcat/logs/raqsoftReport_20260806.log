                    (instr(packprod.prod_name, '[', 1) - 1))
            ELSE
             packprod.prod_name
          END)
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.prod_name
         ELSE
          ''
       END AS custType,
       CASE
       
         WHEN prod.process_biz_type IN ('Q', 'E', 'F') THEN
          packprod.prod_name
         WHEN prod.process_biz_type IN ('L', 'M', 'Y') THEN
          so.pid_code
         ELSE
          ''
       END AS model,
       lot.prod_name,
       a.goods_qty,
       a.lot_status as lotStatus,
       so.cust_lot,
