       decode(a.hold_flag,'Y','Hold','N','Release','','') as holdFlag ,
       md.unit_code,
       so.CUST_PROD_VER_CODE,
       bin.bin_code,
       lot.lot_code,
       lot.PROD_CODE,
       lot.prod_name,
			 pd.pdd_desc,
			 to_char(lot.ACTUAL_COMPLETE_DATE, 'YYYY-MM-DD HH24:MI') as endDate,
       packprod.prod_code,
       packprod.prod_name,
       mo.cust_code,
       mo.cust_name,
       mo.order_type,
       mo.mo_order_group,
       CASE
       
