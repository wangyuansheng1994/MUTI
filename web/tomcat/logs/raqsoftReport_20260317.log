	JOIN (
SELECT DISTINCT
	a.packinglist_code,
	sum( t.PROD_QTY_ACTUAL ) AS goodQty,
	a.packinglist_date,
	a.prod_good_qty,
	a.prod_defect_qty,
	a.TRACKING_CODE,
	a.receive_address_desc,
	a.PROD_QTY,
	a.RECEIVE_CORP_NAME,
	a.RECEIVE_PSN_TEL,
	a.RECEIVE_PSN_NAME,
	a.TRACKING_DESC,
	prod.lot_code,
	max(a.CREATE_DATE) as createDate
FROM
	LOT_PACK_PACKINGLIST a
	JOIN lot_pack_packinglist_dtl d ON a.row_id = d.packinglist_id 
	AND d.del_flag = '0'
	LEFT JOIN LOT_PACK t ON d.lot_pack_id = t.row_id 
	AND t.del_flag = '0' 
