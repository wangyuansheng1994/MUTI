          ''
       END AS model,
       lot.prod_name,
       a.goods_qty,
       a.lot_status as lotStatus,
       so.cust_lot,
       so.cust_po_code,
       lot.mrb_code,
       SUBSTR(DC.calendar_week, 3) AS dc,
	to_char( his.EVENT_DATE, 'YYYY-MM-DD HH24:MI' ) AS tradeDate 
  FROM (select a.*, lot.lot_status
          from WMS_INVENTORY a
          LEFT JOIN lot_pack pack
            ON pack.row_id = a.goods_id
          LEFT JOIN lot_info lot
            ON lot.row_id = pack.lot_id
         where a.position_type = 'Middle'
           AND a.position_code = 'PK_BOX'
           and a.del_flag = '0'
           and lot.del_flag = '0'
           and pack.del_flag = '0'
           and lot.lot_status != 'Terminate') a
	LEFT JOIN WMS_INVENTORY_HIS his ON his.inv_id = a.row_id 
	AND his.event_type = 'Putaway' 
	AND his.del_flag = '0'
  LEFT JOIN v_codelist vc
    ON vc.ENUM_CODE = a.biz_status
   and list_code = 'WMS_INVENTORY_BIZ_STATUS'
  LEFT JOIN md_whs_unit md
    ON a.whs_unit_id = md.row_id
  LEFT JOIN lot_pack pack
    ON pack.row_id = a.goods_id
  LEFT JOIN lot_pack_prod packprod
    ON packprod.pack_id = pack.row_id
  LEFT JOIN lot_info lot
    ON lot.row_id = packprod.lot_id
			 LEFT JOIN PD_DESIGN pd on pd.PDD_TGT_ID = lot.prod_id and pd.BIZ_STATUS ='Y' and pd.del_flag ='0'
  LEFT JOIN md_prod_bin bin
    ON bin.row_id = lot.bin_id
  LEFT JOIN md_step step
    ON lot.step_id = step.row_id
  LEFT JOIN mo_order mo
    ON mo.row_id = lot.mo_id
  LEFT JOIN wo_work_order wo
    ON mo.wo_id = wo.row_id
  LEFT JOIN so_sale_order so
    ON wo.so_id = so.row_id, md_product prod, 
 md_factory_calendar_dc DC
 WHERE a.position_type = 'Middle'
   AND a.position_code = 'PK_BOX'
   AND a.del_flag = '0'
   AND a.goods_id = pack.row_id
   AND a.biz_status in ('WaitPutaway', 'Putaway','P_INV', 'Pairing','WPaireMerge') 
   AND pack.del_flag = '0'
   AND pack.pack_status = 'Y'
   AND prod.row_id = lot.prod_id
   AND prod.del_flag = '0'
   AND lot.del_flag = '0'
   AND mo.row_id = lot.mo_id
   AND mo.del_flag = '0'
   and a.biz_status in ('WaitPutaway','Putaway','P_INV','Pairing','WPaireMerge')  
   AND TO_CHAR(mo.prod_date, 'YYYY-MM-DD') =
       TO_CHAR(to_date(DC.Calendar_Date, 'YYYY-MM-DD'), 'YYYY-MM-DD')
   and (step.step_code = ? or ? is null)
