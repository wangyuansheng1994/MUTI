       END AS model,
       lot.prod_name,
       a.goods_qty,
       lot.lot_status as lotStatus,
       so.cust_lot,
       so.cust_po_code,
       lot.mrb_code,
       SUBSTR(DC.calendar_week, 3) AS dc,
