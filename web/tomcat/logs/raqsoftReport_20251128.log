       lot.PROD_CODE,
       lot.prod_name,
			 pd.pdd_desc,
			 to_char(lot.ACTUAL_COMPLETE_DATE, 'YYYY-MM-DD HH24:MI') as endDate,
       packprod.prod_code,
       packprod.prod_name,
       mo.cust_code,
