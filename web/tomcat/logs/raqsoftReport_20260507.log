	WHEN p.process_segment_type ='ASSY_FT' THEN
		'A+T'
END AS process_segment_type,
	b.TRACKING_CODE,
	b.receive_address_desc,--Ship to Address
	b.PROD_QTY,
	b.RECEIVE_CORP_NAME,
	b.RECEIVE_PSN_TEL,
	b.RECEIVE_PSN_NAME,
	b.TRACKING_DESC,
	b.goodQty,
	to_char(
	to_char(
	TO_CHAR( TRUNC( m.MO_DATE ), 'YY' )) || to_char(
	TO_CHAR( m.MO_DATE, 'IW' ))) AS dc,
	b.createDate,
	'BIN1' as bin
FROM
	lot_info t
	JOIN (
SELECT DISTINCT
	a.packinglist_code,
	sum( t.PROD_QTY_ACTUAL ) AS goodQty,
	a.packinglist_date,
	a.prod_good_qty,
	a.prod_defect_qty,
	a.TRACKING_CODE,
	a.receive_address_desc,
