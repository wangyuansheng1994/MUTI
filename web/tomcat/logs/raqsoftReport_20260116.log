 WHERE a.row_id = b.item_id
   and b.del_flag = '0'
   and b.active_flag = 'Y'
AND ( a.item_code LIKE ? OR ? IS NULL ) 
AND ( a.item_name LIKE ? OR ? IS NULL ) 
AND ( b.prod_name LIKE ? OR ? IS NULL ) 
 ORDER BY a.biz_type, a.item_name, b.prod_code, b.biz_type

